# Copy to .env and adjust as needed.

# General
APP_NAME=Sistema de Gestión de Pagos y Flujo de Efectivo – Monte Esmeralda
ENVIRONMENT=development

# Database backend selector: "sqlite" (local) or "sqlserver" (AWS RDS, production).
DB_BACKEND=sqlite

# Local SQLite path. Used when DB_BACKEND=sqlite.
DATABASE_URL=sqlite:///./monte_esmeralda.db

# Para SQL Server (producción), cambiar DB_BACKEND=sqlserver y llenar:
# DB_HOST=mi-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=1433
# DB_NAME=MESistemaGestionPagos
# DB_USER=usuario_app
# DB_PASSWORD=          (las credenciales reales van solo en .env, nunca aquí)
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=yes
# ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Auth — CHANGE THIS in any non-local environment.
JWT_SECRET=CAMBIAR-por-secreto-fuerte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# File storage
STORAGE_BACKEND=local
STORAGE_DIR=./uploads

# CORS
FRONTEND_ORIGIN=http://localhost:3000
