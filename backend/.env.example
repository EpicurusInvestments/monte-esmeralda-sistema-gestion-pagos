# Copy to .env and adjust as needed.

# General
APP_NAME=Sistema de Gestión de Pagos y Flujo de Efectivo – Monte Esmeralda
ENVIRONMENT=development

# Postgres (used by docker-compose). For local non-docker dev you can leave the
# default SQLite URL by simply not setting this variable.
DATABASE_URL=postgresql+psycopg2://monte:monte@db:5432/monte_esmeralda

# Auth — CHANGE THIS in any non-local environment.
JWT_SECRET=CAMBIAR-por-secreto-fuerte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# File storage
STORAGE_BACKEND=local
STORAGE_DIR=./uploads

# CORS
FRONTEND_ORIGIN=http://localhost:3000
