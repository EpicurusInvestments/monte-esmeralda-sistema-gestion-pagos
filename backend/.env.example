# Copy to .env and adjust as needed.

# General
APP_NAME=Sistema de Gestión de Pagos y Flujo de Efectivo – Monte Esmeralda
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS — dos modos, se eligen con DB_BACKEND.
#
#   sqlite     → desarrollo y pruebas. Archivo local (abajo). Es el modo por defecto y el que
#                deben usar los smoke e2e de Playwright.
#   sqlserver  → BASE OFICIAL en AWS RDS (MESistemaGestionPagos). Para verificar contra datos
#                reales. Requiere ODBC Driver 18 y credenciales (solo en tu .env).
#
# Tras cambiar este archivo hay que REINICIAR uvicorn: `--reload` recarga el código, no el .env.
#
# NUNCA apuntes a sqlserver para correr pytest o los e2e: crean y borran datos, y esa instancia
# es la base oficial y está compartida. (pytest, de hecho, ignora este archivo: siempre usa
# SQLite en memoria — ver backend/tests/conftest.py.)
# ─────────────────────────────────────────────────────────────────────────────
DB_BACKEND=sqlite

# Ruta de la SQLite local. Se usa cuando DB_BACKEND=sqlite.
DATABASE_URL=sqlite:///./monte_esmeralda.db

# Para la base oficial (AWS): poner DB_BACKEND=sqlserver y llenar estas variables.
# Los valores de abajo son de EJEMPLO; las credenciales reales van solo en tu .env local o en
# AWS Secrets Manager, nunca en este archivo ni en el repositorio.
# DB_HOST=mi-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=1433
# DB_NAME=MESistemaGestionPagos
# DB_USER=usuario_app
# DB_PASSWORD=          (las credenciales reales van solo en .env, nunca aquí)
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=yes
# ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Auth — CHANGE THIS in any non-local environment.
JWT_SECRET=CAMBIAR-por-secreto-fuerte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# File storage
STORAGE_BACKEND=local
STORAGE_DIR=./uploads

# CORS — origen del frontend Vite en dev (`npm run dev` en frontend/).
# En qa/producción se pone el dominio real.
FRONTEND_ORIGIN=http://localhost:5173
